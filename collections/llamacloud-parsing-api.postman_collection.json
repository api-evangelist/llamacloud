          "name": "Upload a file to start a parse job",
          "request": {
            "name": "Upload a file to start a parse job",
            "description": {
              "content": "Uploads a document and creates an asynchronous LlamaParse job. Returns a job id used to poll status and retrieve results in Markdown or JSON.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "parsing",
                "upload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "The document to parse (PDF, DOCX, PPTX, image, etc.)."
                },
                {
                  "key": "parsing_instruction",
                  "value": "<string>",
                  "type": "text",
                  "description": "Natural-language instructions to guide parsing."
                },
                {
                  "key": "result_type",
                  "value": "markdown",
                  "type": "text",
                  "description": " (This can only be one of markdown,text,json)"
                },
                {
                  "key": "language",
                  "value": "<string>",
                  "type": "text",
                  "description": "Primary document language hint (e.g. en)."
